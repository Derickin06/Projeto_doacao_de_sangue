# Copie para .env e ajuste.  (Na AWS, o deploy/aws/instalar.sh cria este arquivo sozinho.)

# --- Rodando com Python direto (uvicorn) -------------------------------------
# Sem DATABASE_URL a API usa um SQLite local (arquivo doacao_sangue.db).
# DATABASE_URL=mysql+pymysql://doacao:doacao@localhost:3306/doacao_sangue

# --- Rodando com Docker (docker compose) ------------------------------------
# Senhas do MySQL em container. Troque fora do ambiente de desenvolvimento.
DB_PASSWORD=doacao
DB_ROOT_PASSWORD=root
# Porta em que a API fica acessível (8000 no computador, 80 na AWS)
API_PORT=8000

# --- Comum ------------------------------------------------------------------
# Gere uma chave longa e aleatória, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-de-pelo-menos-32-caracteres
JWT_EXPIRA_MINUTOS=720

# Origens permitidas para o frontend (separadas por vírgula). "*" libera tudo.
CORS_ORIGINS=*
