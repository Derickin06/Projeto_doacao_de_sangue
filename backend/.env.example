# Copie para .env e ajuste. Sem DATABASE_URL a API usa um SQLite local.
DATABASE_URL=mysql+pymysql://doacao:doacao@localhost:3306/doacao_sangue

# Gere uma chave longa e aleatória, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-de-pelo-menos-32-caracteres
JWT_EXPIRA_MINUTOS=720

# Origens permitidas para o frontend (separadas por vírgula). "*" libera tudo.
CORS_ORIGINS=*
